

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.kinal.evaluacion.controller.PrematriculaController"
            prefWidth="850"
            prefHeight="600"
            style="-fx-background-color: #F2F2F2;">

    <top>
        <VBox alignment="CENTER" spacing="5"
              style="-fx-background-color: #DCE8F5;">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="EduControl"
                   style="-fx-font-size: 24px; -fx-text-fill: #28558A;"/>

            <Label text="Prematrícula de Estudiantes"
                   style="-fx-font-size: 17px;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="20" right="25" bottom="15" left="25"/>
            </padding>

            <Label fx:id="lblEstudiante"
                   text="Estudiante:"
                   style="-fx-font-size: 14px;"/>

            <Label text="Secciones disponibles"
                   style="-fx-font-size: 16px;"/>

            <TableView fx:id="tablaSecciones"
                       prefHeight="350"
                       VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="colIdSeccion"
                                 text="ID"
                                 prefWidth="70"/>

                    <TableColumn fx:id="colIdCurso"
                                 text="Curso"
                                 prefWidth="100"/>

                    <TableColumn fx:id="colDocente"
                                 text="Docente"
                                 prefWidth="110"/>

                    <TableColumn fx:id="colCupoMaximo"
                                 text="Cupo máximo"
                                 prefWidth="120"/>

                    <TableColumn fx:id="colCupoDisponible"
                                 text="Disponibles"
                                 prefWidth="120"/>

                </columns>
            </TableView>

            <HBox alignment="CENTER" spacing="12">

                <Button fx:id="btnPrematricular"
                        text="Prematricular sección"
                        onAction="#handlePrematricular"/>

                <Button text="Actualizar lista"
                        onAction="#handleActualizar"/>

            </HBox>

            <Label fx:id="lblMensaje"
                   text=""
                   wrapText="true"/>

        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER">
            <padding>
                <Insets top="10" right="10" bottom="15" left="10"/>
            </padding>

            <Button text="Regresar al menú"
                    onAction="#handleRegresar"/>
        </HBox>
    </bottom>

</BorderPane>

